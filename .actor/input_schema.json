{
  "schemaVersion": 1,
  "title": "Instahyre Scraper Input",
  "type": "object",
  "properties": {
    "searchQuery": {
      "type": "string",
      "title": "Search Query",
      "description": "Job title or skills to search for (e.g. 'python developer', 'data scientist')",
      "editor": "textfield",
      "prefill": "python developer"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "City or region (e.g. 'Bangalore', 'Mumbai', 'Remote')",
      "editor": "textfield",
      "prefill": "Bangalore"
    },
    "minExperience": {
      "type": "integer",
      "title": "Min Experience (years)",
      "description": "Minimum years of experience",
      "minimum": 0,
      "maximum": 20,
      "prefill": 2
    },
    "maxExperience": {
      "type": "integer",
      "title": "Max Experience (years)",
      "description": "Maximum years of experience",
      "minimum": 0,
      "maximum": 20,
      "prefill": 5
    },
    "maxResults": {
      "type": "integer",
      "title": "Max Results",
      "description": "Maximum number of jobs to scrape",
      "minimum": 1,
      "maximum": 1000,
      "default": 50,
      "prefill": 10
    },
    "proxyConfiguration": {
      "type": "object",
      "title": "Proxy Configuration",
      "description": "Apify proxy settings (RESIDENTIAL recommended for Cloudflare bypass)",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      }
    }
  }
}
